  "wiktionary-and-wikisource" -> "wikimedia-commons-pdf";
  "wiktionary-and-wikisource" -> "wikimedia-i18n-l10n-for-tools";
  "wiktionary-and-wikisource" -> "wikimedia-wikitext";
}
