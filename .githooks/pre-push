#!/usr/bin/env python3
"""Pre-push hook: keep skill references honest.

Two checks:

1. Every tooling file referenced in a SKILL.md **Tooling section** exists. A
   "tooling reference" is any path matching scripts/*, assets/*, or references/*.
   Cross-references to other skills (paths starting with "../") are excluded, as
   are explicit stub entries in sections that declare "no scripts/assets/docs
   shipped yet".
2. `scripts/audit-prompt.md`'s batch tables list skills that exist, and list
   *every* skill — the prompt claims to be a complete inventory, and previously
   named two skills that had been merged away while omitting 17 others.
"""

import os, re, sys

ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
SKILLS_DIR = os.path.join(ROOT, ".claude", "skills")
AUDIT_PROMPT = os.path.join(ROOT, "scripts", "audit-prompt.md")

EXIT_OK = 0
EXIT_FAIL = 1

# "| Batch name | skill-a, skill-b | `reports/out.json` |"
BATCH_ROW_RE = re.compile(r"^\|\s*([A-Za-z &]+?)\s*\|([^|]+)\|\s*[^|]*\|", re.MULTILINE)


def parse_audit_batches(text: str) -> dict[str, list[str]]:
    """Return {batch_name: [skill, ...]} from the audit prompt's Phase 2 table."""
    batches: dict[str, list[str]] = {}
    for batch, skills in BATCH_ROW_RE.findall(text):
        batch = batch.strip()
        if batch == "Batch":  # header row
            continue
        names = [s.strip() for s in skills.split(",") if s.strip()]
        if names:
            batches.setdefault(batch, []).extend(names)
    return batches


def existing_skills(skills_dir: str) -> set:
    """Skill directory names that actually contain a SKILL.md."""
    if not os.path.isdir(skills_dir):
        return set()
    return {
        name
        for name in os.listdir(skills_dir)
        if os.path.isfile(os.path.join(skills_dir, name, "SKILL.md"))
    }


def check_audit_prompt(skills_dir: str, prompt_path: str) -> tuple[list[str], list[str]]:
    """Validate the audit prompt's batch tables. Returns (errors, warnings)."""
    if not os.path.isfile(prompt_path):
        return [], []

    with open(prompt_path) as fh:
        batches = parse_audit_batches(fh.read())
    if not batches:
        return ["audit-prompt.md: no batch table found (expected the Phase 2 table)"], []

    skills = existing_skills(skills_dir)
    listed = [name for names in batches.values() for name in names]

    errors = [
        f"audit-prompt.md batch '{batch}' names '{name}', "
        f"but .claude/skills/{name}/SKILL.md does not exist"
        for batch, names in batches.items()
        for name in names
        if name not in skills
    ]

    unlisted = sorted(skills - set(listed))
    if unlisted:
        errors.append(
            f"audit-prompt.md covers {len(set(listed))}/{len(skills)} skills — "
            f"missing from every batch: {', '.join(unlisted)}"
        )

    warnings = [
        f"audit-prompt.md lists '{name}' in more than one batch"
        for name in sorted({n for n in listed if listed.count(n) > 1})
    ]
    return errors, warnings


def find_tooling_references(skill_dir: str) -> list[tuple[str, str]]:
    """Parse SKILL.md for genuinely-missing tooling files.

    Returns list of (relative_path, description_context).
    Only examines the ## Tooling section(s).
    """
    skill_md = os.path.join(skill_dir, "SKILL.md")
    if not os.path.isfile(skill_md):
        return []

    content = open(skill_md).read()
    skill_name = os.path.basename(skill_dir)
    missing = []

    # Extract the Tooling section(s)
    # Find all "## Tooling" headers and extract until next "## " or EOF
    tooling_sections = []
    for m in re.finditer(r"^## Tooling\b", content, re.MULTILINE):
        start = m.start()
        # Find the next ## header at the same level (starts with "## ")
        next_h2 = re.search(r"^## ", content[m.end():], re.MULTILINE)
        end = m.end() + next_h2.start() if next_h2 else len(content)
        tooling_sections.append((start, end))

    if not tooling_sections:
        return []

    # Check if sections declare explicit "no files shipped yet"
    has_planned_marker = any(
        "no scripts shipped yet" in content[s:e].lower()
        or "no assets shipped yet" in content[s:e].lower()
        or "no reference" in content[s:e].lower()
        for s, e in tooling_sections
    )

    for s, e in tooling_sections:
        section = content[s:e]

        # Find all file references: scripts/..., assets/..., references/...
        refs = set(re.findall(
            r'(?:scripts|assets|references)/[\w./-]+',
            section
        ))

        for ref in sorted(refs):
            # Skip cross-references to other skills
            if ref.startswith("../") or ".." in ref:
                continue

            # Skip if the file exists
            full_path = os.path.join(skill_dir, ref)
            if os.path.isfile(full_path):
                continue

            # Skip if this is a directory reference (trailing slash in doc)
            if ref.endswith("/"):
                if os.path.isdir(full_path):
                    # Directory exists — check it has content
                    if os.listdir(full_path):
                        continue
                continue

            # If in a "planned" section, skip — intentional gap
            if has_planned_marker:
                continue

            # Find context — the line mentioning this ref
            context = ""
            for line in section.split("\n"):
                if os.path.basename(ref) in line:
                    context = line.strip()
                    break

            missing.append((ref, context))

    return missing


def main():
    errors = 0
    for name in sorted(os.listdir(SKILLS_DIR)):
        skill_dir = os.path.join(SKILLS_DIR, name)
        if not os.path.isdir(skill_dir):
            continue

        missing = find_tooling_references(skill_dir)
        if missing:
            print(f"\n❌ {name}/SKILL.md references {len(missing)} missing tooling file(s):")
            for ref, ctx in missing:
                print(f"   📄 {ref}")
                if ctx:
                    print(f"      ↳ {ctx[:100]}")
            errors += 1

    audit_errors, audit_warnings = check_audit_prompt(SKILLS_DIR, AUDIT_PROMPT)
    if audit_errors:
        print(f"\n❌ scripts/audit-prompt.md is out of sync with .claude/skills/:")
        for err in audit_errors:
            print(f"   📄 {err}")
        errors += 1
    for warn in audit_warnings:
        print(f"\n⚠️  {warn}")

    if errors:
        print(f"\n━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━")
        print(f"⛔ {errors} check(s) failed.")
        print(f"   Either create the missing files, or remove/fix the references.")
        print(f"━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━")
        return EXIT_FAIL

    print("✅ All tooling references verified — no missing files.")
    print("✅ scripts/audit-prompt.md batch tables match .claude/skills/.")
    return EXIT_OK


if __name__ == "__main__":
    sys.exit(main())
